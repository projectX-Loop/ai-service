# Gemini (2026-09-02 팀 확정). 배포 시에는 SSM Parameter Store에서 주입한다.
GEMINI_API_KEY=...
# 모델 ID는 바뀔 수 있어 덮어쓸 수 있게 열어둔다.
GEMINI_MODEL=gemini-2.0-flash

# KAN-16 · pgvector (로컬 compose 기본값. RDS는 SSM에서 주입)
DATABASE_URL=postgresql://loop:loop@localhost:5432/loop
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
